# Local development (docker compose up db)
DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:54322/studio

# Supabase (production). Use the "Session pooler" connection string from
# Project Settings > Database, with the driver changed to postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth: set SUPABASE_URL for projects using JWT signing keys (JWKS),
# or SUPABASE_JWT_SECRET for the legacy shared secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=dev-only-secret-change-me-32-bytes-min

CORS_ORIGINS=["http://localhost:3000"]
DAILY_PROJECT_LIMIT=3

# AI providers (all free tiers). Tried in this order; any without a key are skipped.
LLM_CHAIN=["gemini","groq","openrouter"]
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys
# Fully offline instead: install Ollama, `ollama pull llama3.2`, and set LLM_CHAIN=["ollama"]
LLM_DAILY_CALL_LIMIT=400
